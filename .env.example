LLM_API_KEY="xxx"
MINIMAX_API_KEY="xxx"
MINIMAX_TTS_MODEL="speech-2.6-hd"

# 云端部署用 production（compose 部署时 PG_HOST/REDIS_HOST 会被自动指向容器，无需改这里）
ENV=development
APP_NAME=who-is-spy
# nginx 同源反代 /api，默认无需跨域；如需直连后端再添加来源
ALLOW_ORIGINS=["http://localhost:5173"]

# 前端对外端口（docker-compose.yml 的 web 服务）
WEB_PORT=80

PG_HOST=localhost
PG_PORT=5432
PG_DB=who_is_spy
PG_USER=postgres
PG_PSW=postgres
PG_CONN_MAX=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PSW=